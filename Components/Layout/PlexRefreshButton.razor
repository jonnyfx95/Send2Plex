@rendermode InteractiveServer
@inject PlexClient Plex

<button class="btn-refresh" title="@refreshTooltip" disabled="@refreshing" @onclick="RefreshPlexAsync">
    <span class="@(refreshing ? "spin" : "")">🔄</span>
</button>

<style>
    .btn-refresh { background: none; border: none; cursor: pointer; font-size: 1rem; line-height: 1; padding: 4px 6px; border-radius: 6px; color: inherit; }
    .btn-refresh:hover:not(:disabled) { background: var(--border); }
    .btn-refresh:disabled { cursor: default; opacity: 0.6; }
    .btn-refresh .spin { display: inline-block; animation: btn-refresh-spin 0.8s linear infinite; }
    @@keyframes btn-refresh-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>

@code {
    private bool refreshing;
    private string refreshTooltip = "Aggiorna librerie Plex";

    private async Task RefreshPlexAsync()
    {
        refreshing = true;
        refreshTooltip = "Aggiorno…";
        try
        {
            var moviesTask = Plex.RefreshAsync(toTv: false, CancellationToken.None);
            var tvTask = Plex.RefreshAsync(toTv: true, CancellationToken.None);
            var results = await Task.WhenAll(moviesTask, tvTask);
            refreshTooltip = results.All(ok => ok)
                ? "✅ Refresh Plex avviato"
                : "⚠️ Refresh Plex non riuscito per una o più librerie";
        }
        finally
        {
            refreshing = false;
        }
    }
}
