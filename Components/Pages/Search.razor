@page "/cerca"
@rendermode InteractiveServer
@implements IDisposable
@inject TmdbClient Tmdb
@inject TorrentSearchService TorrentSearch
@inject ConfigStore ConfigStore
@inject NordVpnController Vpn
@inject PlexClient Plex
@inject DownloadOrchestrator Orchestrator
@inject DownloadQueueService Queue
@inject DebridProviderFactory DebridFactory
@inject NavigationManager Nav

<PageTitle>Send2Plex — Cerca</PageTitle>

<div class="page-container">
    <h1>Cerca</h1>
    <p class="page-lede">Trova un film o una serie sui siti configurati e scaricalo direttamente su Plex.</p>

    <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;">
        <span style="font-size:0.85rem; color:var(--text-dim);">Provider debrid</span>
        <button type="button" class="btn btn-sm @(pageProvider == "allDebrid" ? "btn-primary" : "btn-ghost")" style="display:flex; align-items:center; gap:6px;" @onclick='() => pageProvider = "allDebrid"'><img src="/img/provider/alldebrid.png" alt="" style="width:18px; height:18px; object-fit:contain;" />AllDebrid</button>
        <button type="button" class="btn btn-sm @(pageProvider == "realDebrid" ? "btn-primary" : "btn-ghost")" style="display:flex; align-items:center; gap:6px;" @onclick='() => pageProvider = "realDebrid"'><img src="/img/provider/realdebrid.png" alt="" style="width:18px; height:18px; object-fit:contain;" />Real-Debrid</button>
        <button type="button" class="btn btn-sm @(pageProvider == "premiumize" ? "btn-primary" : "btn-ghost")" style="display:flex; align-items:center; gap:6px;" @onclick='() => pageProvider = "premiumize"'><img src="/img/provider/premiumizeme.png" alt="" style="width:18px; height:18px; object-fit:contain;" />Premiumize</button>
    </div>

    <form class="searchbar section-gap" style="max-width:520px" @onsubmit="SearchQueryAsync">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
        <input type="text" placeholder="Cosa vuoi cercare?" @bind="query" @bind:event="oninput" />
        <button type="submit" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(query) || busy)">Cerca</button>
    </form>

    @if (candidates is not null)
    {
        <div class="section-gap">
            <p style="margin-bottom:10px;">Ho trovato più titoli per "<strong>@query</strong>" — quale intendi?</p>
            <div class="filters-row" style="margin-bottom:14px;">
                <button class="btn btn-sm @(candidateFilter == "all" ? "btn-primary" : "btn-ghost")" @onclick='() => candidateFilter = "all"'>Tutti</button>
                <button class="btn btn-sm @(candidateFilter == "movie" ? "btn-primary" : "btn-ghost")" @onclick='() => candidateFilter = "movie"'>🎬 Film</button>
                <button class="btn btn-sm @(candidateFilter == "tv" ? "btn-primary" : "btn-ghost")" @onclick='() => candidateFilter = "tv"'>📺 Serie TV</button>
                <button class="btn btn-sm @(candidateFilter == "anime" ? "btn-primary" : "btn-ghost")" @onclick='() => candidateFilter = "anime"'>⛩️ Anime</button>
            </div>
            @if (FilteredCandidates.Count == 0)
            {
                <p class="page-lede">Nessun titolo corrisponde a questo filtro.</p>
            }
            else
            {
                <div style="display:flex; flex-wrap:wrap; gap:14px;">
                    @foreach (var c in FilteredCandidates)
                    {
                        <button type="button" class="panel candidate-card" disabled="@busy" @onclick="() => PickCandidateAsync(c)">
                            @if (!string.IsNullOrWhiteSpace(c.PosterUrl))
                            {
                                <img src="@c.PosterUrl" alt="" style="width:100%; border-radius:6px; display:block;" />
                            }
                            <div style="padding:8px 2px 2px;">
                                <div style="font-weight:600; font-size:0.88rem;">@c.Title @(c.Year is not null ? $"({c.Year})" : "")</div>
                                <div style="font-size:0.78rem; color:var(--text-dim); margin-top:2px;">
                                    @(c.MediaType == "tv" ? "📺 Serie TV" : "🎬 Film")@(c.IsAnime ? " · ⛩️ Anime" : "")
                                </div>
                            </div>
                        </button>
                    }
                </div>
            }
        </div>
    }
    else if (poster is not null)
    {
        <div class="panel section-gap" style="display:flex; gap:20px;">
            @if (!string.IsNullOrWhiteSpace(poster.PosterUrl))
            {
                <img src="@poster.PosterUrl" alt="" style="width:100px; border-radius:6px; flex-shrink:0; align-self:flex-start;" />
            }
            <div>
                <h3>@poster.Title @(poster.Year is not null ? $"({poster.Year})" : "")</h3>
                @if (poster.MediaType == "movie" && ownedMovie == true)
                {
                    <p class="tag-ok" style="margin:4px 0 0;">✅ Già presente nella tua libreria</p>
                }
                else if (poster.MediaType == "tv" && ownedEpisodesForShow is { Count: > 0 })
                {
                    <p class="tag-ok" style="margin:4px 0 0;">✅ Alcuni episodi sono già nella tua libreria</p>
                }
                <p class="page-lede" style="margin-top:8px;">@poster.Overview</p>
                @if (!string.IsNullOrWhiteSpace(trailerKey))
                {
                    @if (showTrailer)
                    {
                        <div class="trailer-embed" style="margin-top:12px;">
                            <iframe width="100%" height="220" src="https://www.youtube-nocookie.com/embed/@trailerKey" title="Trailer" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-ghost btn-sm" style="margin-top:12px;" @onclick="() => showTrailer = true">▶️ Guarda trailer</button>
                    }
                }
            </div>
        </div>

        <div class="dest-toggle section-gap">
            <span class="dest-label">Salva in</span>
            <button type="button" class="btn btn-sm @(destinationIsTv == "false" ? "btn-primary" : "btn-ghost")" @onclick="() => SetDestination(false)">🎬 Movies</button>
            <button type="button" class="btn btn-sm @(destinationIsTv == "true" ? "btn-primary" : "btn-ghost")" @onclick="() => SetDestination(true)">📺 TV</button>
            @if (CurrentSectionOptions.Count > 1)
            {
                <select class="input" style="max-width:200px" value="@selectedSectionId" @onchange="e => selectedSectionId = int.Parse(e.Value!.ToString()!)">
                    @foreach (var s in CurrentSectionOptions)
                    {
                        <option value="@s.Id">@s.Title</option>
                    }
                </select>
            }
            <span class="dest-hint">rilevato automaticamente da TMDB, correggi se serve</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-info section-gap">@statusMessage</div>
    }

    @if (enabledSites.Count > 0 && !awaitingTorrentioInput)
    {
        <div class="filters-row section-gap">
            @foreach (var site in enabledSites)
            {
                <button class="btn btn-ghost btn-sm" disabled="@busy" @onclick="() => SelectSiteAsync(site)">@site.Name</button>
            }
        </div>
    }

    @if (awaitingTorrentioInput && torrentioMatch is not null)
    {
        <div class="section-gap">
            <p style="margin-bottom:14px;">📺 <strong>@torrentioMatch.Title</strong> — quale stagione? (prendo tutti gli episodi)</p>
            @if (loadingSeasons)
            {
                <p style="color:var(--text-dim);">Carico le stagioni da TMDB…</p>
            }
            else if (torrentioSeasons.Count == 0)
            {
                <p style="color:var(--text-dim);">Nessuna stagione trovata su TMDB per questo titolo.</p>
            }
            else
            {
                <div class="filters-row">
                    @foreach (var s in torrentioSeasons)
                    {
                        <button class="btn btn-ghost" disabled="@busy" @onclick="() => SelectTorrentioSeasonAsync(s)">
                            @s.Name (@s.EpisodeCount ep.)
                        </button>
                    }
                </div>
            }
        </div>
    }

    @if (results is not null)
    {
        <h3 class="section-gap" style="margin-bottom:16px;">Risultati (@filteredResults.Count / @results.Count)</h3>

        <div class="filters-row">
            <select class="input" style="max-width:170px" @bind="filterSeason">
                <option value="">Tutte le stagioni</option>
                @foreach (var s in availableSeasons)
                {
                    <option value="@s">Stagione @s</option>
                }
            </select>
            <select class="input" style="max-width:170px" @bind="filterResolution">
                <option value="">Tutte le risoluzioni</option>
                @foreach (var r in availableResolutions)
                {
                    <option value="@r">@r</option>
                }
            </select>
            <select class="input" style="max-width:170px" @bind="filterLanguage">
                <option value="">Tutte le lingue</option>
                @foreach (var l in availableLanguages)
                {
                    <option value="@l">@l</option>
                }
            </select>
            <select class="input" style="max-width:170px" @bind="filterEpisode">
                <option value="">Tutti gli episodi</option>
                @foreach (var e in availableEpisodes)
                {
                    <option value="@e">Episodio @e</option>
                }
            </select>
        </div>

        <div style="overflow-x:auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Ep.</th>
                        <th>Titolo</th>
                        <th>Size</th>
                        <th>Seed</th>
                        <th>Fonte</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in filteredResults)
                    {
                        var epNum = ParseEpisode(r.Title);
                        <tr>
                            <td class="tabular" data-label="Ep.">
                                @if (epNum is not null && IsEpisodeOwned(epNum.Value))
                                {
                                    <span title="Già in libreria">✅ </span>
                                }
                                @(epNum?.ToString() ?? "–")
                            </td>
                            <td class="title-cell" data-label="Titolo" title="@r.Title">@r.Title</td>
                            <td class="tabular" data-label="Size">@(r.SizeText ?? "?")</td>
                            <td class="tabular" data-label="Seed">@(r.SeedsText ?? "?")</td>
                            <td data-label="Fonte">@(r.SourceListName ?? r.SiteName)</td>
                            <td data-label="Azione">
                                @if (downloadingResult == r)
                                {
                                    <div class="dl-progress">
                                        <div class="dl-progress-fill" style="width:@(Math.Max(6, activeDownloadPercent))%"></div>
                                        <span class="dl-progress-label">@DownloadLabel()</span>
                                    </div>
                                }
                                else
                                {
                                    var fstate = GetFileState(r);
                                    <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
                                        <button type="button" class="btn btn-ghost btn-sm" style="padding:4px 8px;" disabled="@(busy || fstate.Busy)" title="Provider debrid per questo file: @ProviderLabel(fstate.Provider) (tocca per cambiare)" @onclick="() => ToggleRowProvider(fstate)">
                                            <img src="/img/provider/@(ParseProvider(fstate.Provider).ToIconFileName()).png" alt="@ProviderLabel(fstate.Provider)" style="width:20px; height:20px; object-fit:contain; display:block;" />
                                        </button>
                                        <button class="btn btn-ok btn-sm" disabled="@busy" @onclick="() => DownloadAsync(r)">Scarica</button>
                                        <button class="btn btn-ghost btn-sm" disabled="@busy" title="Aggiungi alla coda invece di scaricare subito" @onclick="() => EnqueueResult(r)">➕ Coda</button>
                                        <button class="btn btn-ghost btn-sm" disabled="@(busy || fstate.Busy)" title="Guarda subito in streaming, senza scaricare su disco" @onclick="() => WatchResultAsync(r, fstate)">▶️ Guarda</button>
                                        <button class="btn btn-ghost btn-sm" disabled="@(busy || fstate.Busy)" title="Scegli quali file scaricare invece di tutti (richiede caricare il magnet sul provider)" @onclick="() => ToggleFilesAsync(r, fstate)">
                                            @(fstate.ShowPanel ? "📄 Nascondi file" : "📄 Scegli file")
                                        </button>
                                        @if (fstate.Provider == "premiumize")
                                        {
                                            <button class="btn btn-ghost btn-sm" disabled="@(busy || fstate.Busy || selectedSectionId is null)" title="Acquisisci nel cloud Premiumize e mostralo in libreria Plex, senza occupare spazio sul disco locale" @onclick="() => AcquireToLibraryAsync(r, fstate)">📚 Acquisisci in libreria</button>
                                        }
                                    </div>
                                    @if (enqueuedResult == r)
                                    {
                                        <div style="font-size:0.78rem; color:var(--text-dim); margin-top:4px;">Aggiunto alla coda</div>
                                    }
                                    @if (fstate.ShowPanel)
                                    {
                                        <div class="panel" style="margin-top:8px; padding:8px 14px; max-width:420px;">
                                            @if (fstate.Preparing)
                                            {
                                                <span style="font-size:0.82rem; color:var(--text-dim);">@(fstate.Message ?? "🧲 Preparo il magnet su AllDebrid…")</span>
                                            }
                                            else if (fstate.Files is { Count: 0 })
                                            {
                                                <span style="font-size:0.82rem; color:var(--text-dim);">Nessun file trovato.</span>
                                            }
                                            else if (fstate.Files is not null)
                                            {
                                                @foreach (var f in fstate.Files)
                                                {
                                                    <div class="checkbox-row" style="font-size:0.85rem;">
                                                        <input type="checkbox"
                                                               id="@($"sfile-{f.Link.GetHashCode()}")"
                                                               checked="@fstate.SelectedLinks.Contains(f.Link)"
                                                               @onchange="e => ToggleFileSelection(fstate, f.Link, (bool)e.Value!)" />
                                                        <label for="@($"sfile-{f.Link.GetHashCode()}")" title="@f.Name">@Truncate(f.Name, 44) <span style="color:var(--text-dim)">(@FormatSize(f.Size))</span></label>
                                                        <button type="button" class="btn btn-ghost btn-sm" style="padding:2px 8px;" title="Guarda questo file in streaming" @onclick="() => NavigateToWatch(f, f.Name, fstate.Provider)">▶️</button>
                                                    </div>
                                                }
                                                <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:8px;">
                                                    <button class="btn btn-primary btn-sm" disabled="@fstate.Busy" @onclick="() => DownloadSelectedAsync(r, fstate)">
                                                        @(fstate.Busy ? "Scarico…" : "Scarica selezionati")
                                                    </button>
                                                    <button class="btn btn-ghost btn-sm" disabled="@fstate.Busy" @onclick="() => EnqueueSelected(r, fstate)">➕ Coda (selezionati)</button>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(fstate.Message) && !fstate.Preparing)
                                            {
                                                <div style="font-size:0.78rem; color:var(--text-dim); margin-top:6px;">@fstate.Message</div>
                                            }
                                        </div>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(downloadResultMessage))
    {
        <div class="alert alert-ok" style="margin-top:16px;">@downloadResultMessage</div>
    }
</div>

<style>
    .candidate-card {
        width: 140px;
        text-align: left;
        cursor: pointer;
        font: inherit;
        color: inherit;
        padding: 8px;
    }
    .candidate-card:disabled { cursor: default; opacity: 0.6; }
    .candidate-card:not(:disabled):hover { border-color: var(--accent); }
</style>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    private string? QueryFromUrl { get; set; }

    // Arrivo dalla pagina di dettaglio serie (episodio mancante): salta il selettore stagione
    // e lancia subito la ricerca Torrentio per quella stagione/episodio specifici.
    [SupplyParameterFromQuery(Name = "season")]
    private int? SeasonFromUrl { get; set; }

    [SupplyParameterFromQuery(Name = "episode")]
    private int? EpisodeFromUrl { get; set; }

    private TorrentSearchSettings SearchCfg => ConfigStore.Current.TorrentSearch;
    private List<TorrentSiteConfig> enabledSites => SearchCfg.Sites
        .Where(s => s.Enabled)
        .OrderByDescending(s => s.UseTorrentioApi) // Torrentio (motore di default) sempre per primo
        .ToList();

    // Provider debrid (Punto UI ibrida, vedi piano): default persistito -> toggle di pagina -> icona
    // per-risultato. "allDebrid"/"realDebrid" come stringa (stesso stile di destinationIsTv),
    // convertito in DebridProvider solo al momento di chiamare l'orchestrator.
    private string pageProvider = "allDebrid";

    private static string ProviderLabel(string provider) => ParseProvider(provider).ToDisplayName();
    private static DebridProvider ParseProvider(string provider) => DebridProviderNames.ParseApiValue(provider);

    // Tap sull'icona per-riga: cicla tra i 3 provider (AllDebrid → Real-Debrid → Premiumize →
    // AllDebrid), stesso principio del toggle a 2 vie originale, esteso al terzo provider.
    private static readonly string[] ProviderCycle = { "allDebrid", "realDebrid", "premiumize" };

    private void ToggleRowProvider(FileSelectState state)
    {
        var currentIndex = Array.IndexOf(ProviderCycle, state.Provider);
        state.Provider = ProviderCycle[(currentIndex + 1) % ProviderCycle.Length];
        // Un magnet già preparato resta legato al provider con cui è stato caricato: cambiare
        // provider dopo la preparazione invalida quel magnet, va ripreparato da capo sul nuovo.
        state.MagnetId = null;
        state.Files = null;
        state.SelectedLinks.Clear();
        state.ShowPanel = false;
    }

    private string query = "";
    private TmdbPosterInfo? poster;
    private string? trailerKey;
    private bool showTrailer;
    private string? statusMessage;
    private bool busy;

    private TmdbImdbMatch? torrentioMatch;
    private TorrentSiteConfig? torrentioSite;
    private TorrentSiteConfig? selectedSite;
    private bool awaitingTorrentioInput;
    private List<TmdbSeasonInfo> torrentioSeasons = new();
    private bool loadingSeasons;

    private List<TorrentSearchResult>? results;
    private string filterSeason = "";
    private string filterResolution = "";
    private string filterLanguage = "";
    private string filterEpisode = "";
    private string destinationIsTv = "false";
    private List<PlexSectionInfo> movieSections = new();
    private List<PlexSectionInfo> tvSections = new();
    private int? selectedSectionId;

    private List<PlexSectionInfo> CurrentSectionOptions => destinationIsTv == "true" ? tvSections : movieSections;

    private void SetDestination(bool toTv, bool isAnime = false)
    {
        // Se il titolo è riconosciuto come anime (euristica TMDB), cerca una libreria "Anime" in
        // ENTRAMBE le liste (Movies e TV), non solo in quella del tipo TMDB del titolo: un film
        // anime (media_type "movie") può benissimo avere la sua libreria Anime configurata sotto
        // TV in Plex (o viceversa) — l'utente vuole che finisca lì comunque, indipendentemente da
        // come TMDB classifica il titolo.
        if (isAnime)
        {
            var animeInTv = tvSections.FirstOrDefault(s => s.Title.Contains("anime", StringComparison.OrdinalIgnoreCase));
            var animeInMovies = movieSections.FirstOrDefault(s => s.Title.Contains("anime", StringComparison.OrdinalIgnoreCase));
            var anime = animeInTv ?? animeInMovies;
            if (anime is not null)
            {
                destinationIsTv = animeInTv is not null ? "true" : "false";
                selectedSectionId = anime.Id;
                return;
            }
        }

        destinationIsTv = toTv ? "true" : "false";
        var options = toTv ? tvSections : movieSections;
        selectedSectionId = options.Count > 0 ? options[0].Id : null;
    }

    private TorrentSearchResult? downloadingResult;
    private double activeDownloadPercent;
    private string? activeDownloadSpeed;
    private string? downloadResultMessage;

    private bool? ownedMovie;
    private HashSet<(int Season, int Episode)>? ownedEpisodesForShow;
    private int? currentSeasonNumber;

    // Selettore multi-candidato TMDB (Film/Serie TV/Anime che condividono lo stesso titolo, es.
    // "Supergirl" serie 2015 e film 2026): valorizzato solo quando la ricerca trova più di un
    // risultato plausibile, altrimenti si procede subito con l'unico trovato come prima.
    private List<TmdbCandidate>? candidates;
    private TmdbCandidate? selectedCandidate;
    private string candidateFilter = "all";

    private List<TmdbCandidate> FilteredCandidates => candidates is null ? new() : candidateFilter switch
    {
        "movie" => candidates.Where(c => c.MediaType == "movie").ToList(),
        "tv" => candidates.Where(c => c.MediaType == "tv").ToList(),
        "anime" => candidates.Where(c => c.IsAnime).ToList(),
        _ => candidates
    };

    protected override async Task OnInitializedAsync()
    {
        ProgressEvents.OnProgressUpdate += OnProgressUpdate;
        ProgressEvents.OnDownloadComplete += OnDownloadComplete;

        var (movies, tv) = await Plex.GetConfiguredSectionsAsync(CancellationToken.None);
        movieSections = movies;
        tvSections = tv;
        SetDestination(false);
        pageProvider = ConfigStore.Current.General.PreferredDebridProvider.ToApiValue();

        // Arrivo da un click su un poster in Home (o da un link diretto con ?q=...): precompila
        // e avvia subito la ricerca, come se l'utente l'avesse scritta a mano.
        if (!string.IsNullOrWhiteSpace(QueryFromUrl))
        {
            query = QueryFromUrl;
            await SearchQueryAsync();
        }
    }

    public void Dispose()
    {
        ProgressEvents.OnProgressUpdate -= OnProgressUpdate;
        ProgressEvents.OnDownloadComplete -= OnDownloadComplete;
    }

    private void OnProgressUpdate(string fileName, double percent, string speed, string eta)
    {
        activeDownloadPercent = percent;
        activeDownloadSpeed = speed;
        InvokeAsync(StateHasChanged);
    }

    private void OnDownloadComplete(string fileName, string destPath)
    {
        downloadResultMessage = $"✅ Completato: {fileName} → {destPath}";
        InvokeAsync(StateHasChanged);
    }

    private async Task SearchQueryAsync()
    {
        if (string.IsNullOrWhiteSpace(query)) return;

        busy = true;
        results = null;
        awaitingTorrentioInput = false;
        statusMessage = null;
        ownedMovie = null;
        ownedEpisodesForShow = null;
        currentSeasonNumber = null;
        trailerKey = null;
        showTrailer = false;
        poster = null;
        candidates = null;
        selectedCandidate = null;
        candidateFilter = "all";
        try
        {
            var found = await Tmdb.SearchCandidatesAsync(query, CancellationToken.None);

            if (found.Count == 0)
            {
                statusMessage = $"❌ Non ho trovato \"{query}\" su TMDB.";
                return;
            }

            // Se c'è un solo candidato, si procede subito come prima (nessun passaggio in più per
            // il caso comune). Con più candidati (es. "Supergirl" serie 2015 + film 2026), è
            // l'utente a scegliere quale intende dal selettore mostrato in pagina.
            if (found.Count == 1)
                await ProceedWithCandidateAsync(found[0]);
            else
                candidates = found;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task PickCandidateAsync(TmdbCandidate c)
    {
        busy = true;
        try
        {
            await ProceedWithCandidateAsync(c);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ProceedWithCandidateAsync(TmdbCandidate c)
    {
        selectedCandidate = c;
        candidates = null;
        statusMessage = null;

        poster = new TmdbPosterInfo
        {
            TmdbId = c.TmdbId,
            Title = c.Title,
            Year = c.Year,
            Overview = c.Overview,
            PosterUrl = c.PosterUrl ?? "",
            MediaType = c.MediaType
        };

        // Rileva in automatico Movies/TV/Anime dal tipo scelto, così l'utente non deve ricordarsi
        // di impostarlo a mano (e rischiare di scaricare nella cartella sbagliata).
        SetDestination(c.MediaType == "tv", c.IsAnime);

        await CheckOwnershipAsync();

        trailerKey = await Tmdb.GetTrailerAsync(c.TmdbId, c.MediaType == "tv", CancellationToken.None);

        // Torrentio è il motore di default: appena scelto il titolo, parte subito su di lui (se
        // abilitato) senza dover scegliere il sito a mano. Gli altri siti restano comunque
        // disponibili come bottoni, per cambiare fonte.
        var defaultSite = enabledSites.FirstOrDefault(s => s.UseTorrentioApi);
        if (defaultSite is not null)
        {
            await SelectSiteCoreAsync(defaultSite);
        }
    }

    private async Task SelectSiteAsync(TorrentSiteConfig site)
    {
        busy = true;
        statusMessage = null;
        results = null;
        awaitingTorrentioInput = false;
        torrentioSeasons = new();
        try
        {
            await SelectSiteCoreAsync(site);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SelectSiteCoreAsync(TorrentSiteConfig site)
    {
        if (site.UseTorrentioApi)
            {
                statusMessage = $"🔎 Cerco \"{query}\" su TMDB per Torrentio…";

                // Se l'utente ha già scelto un candidato specifico (selettore multi-risultato),
                // risolve l'IMDb ID direttamente da quel TMDB id/tipo — evita di rifare una ricerca
                // testuale fuzzy che potrebbe risolvere un titolo diverso da quello scelto (es.
                // "Supergirl" film invece della serie appena selezionata).
                TmdbImdbMatch? match = null;
                if (selectedCandidate is not null)
                {
                    var imdbId = await Tmdb.GetImdbIdAsync(selectedCandidate.TmdbId, selectedCandidate.MediaType, CancellationToken.None);
                    if (!string.IsNullOrWhiteSpace(imdbId))
                        match = new TmdbImdbMatch { TmdbId = selectedCandidate.TmdbId, ImdbId = imdbId, MediaType = selectedCandidate.MediaType, Title = selectedCandidate.Title };
                }
                match ??= await Tmdb.ResolveImdbIdAsync(query, CancellationToken.None);

                if (match is null)
                {
                    statusMessage = $"❌ Non ho trovato \"{query}\" su TMDB.";
                    return;
                }

                if (match.MediaType == "movie")
                {
                    statusMessage = null;
                    await RunSearchAsync(site, () => TorrentSearch.SearchTorrentioApiAsync(site, match.ImdbId, match.MediaType, null, null, SearchCfg.MaxResultsPerSite, CancellationToken.None));
                }
                else
                {
                    torrentioMatch = match;
                    torrentioSite = site;
                    statusMessage = null;

                    loadingSeasons = true;
                    torrentioSeasons = await Tmdb.GetSeasonsAsync(match.TmdbId, CancellationToken.None);
                    loadingSeasons = false;

                    // Se arrivo con stagione/episodio già indicati (click su un episodio
                    // mancante dalla pagina serie), salto il selettore e cerco subito.
                    var wantedSeason = SeasonFromUrl;
                    var wantedEpisode = EpisodeFromUrl;
                    SeasonFromUrl = null;
                    EpisodeFromUrl = null;

                    var targetSeason = wantedSeason is { } ws ? torrentioSeasons.FirstOrDefault(s => s.SeasonNumber == ws) : null;
                    if (targetSeason is not null)
                    {
                        awaitingTorrentioInput = false;
                        await SelectTorrentioSeasonAsync(targetSeason);
                        if (wantedEpisode is { } we)
                            filterEpisode = we.ToString();
                    }
                    else
                    {
                        awaitingTorrentioInput = true;
                    }
                }

                return;
            }

            statusMessage = $"🔎 Ricerca \"{query}\" su {site.Name} in corso…";
            await RunSearchAsync(site, async () =>
            {
                if (site.RequiresVpn) await Vpn.ConnectAsync(CancellationToken.None);
                return await TorrentSearch.SearchSiteAsync(site, query, SearchCfg.TimeoutSeconds, SearchCfg.MaxResultsPerSite, CancellationToken.None);
            });
    }

    private async Task SelectTorrentioSeasonAsync(TmdbSeasonInfo chosenSeason)
    {
        if (torrentioSite is null || torrentioMatch is null) return;

        busy = true;
        try
        {
            var site = torrentioSite;
            var match = torrentioMatch;
            var season = chosenSeason.SeasonNumber;
            var episodeCount = Math.Max(1, chosenSeason.EpisodeCount);
            awaitingTorrentioInput = false;
            currentSeasonNumber = season;

            statusMessage = $"🔎 Cerco su Torrentio {episodeCount} episodi di {chosenSeason.Name}…";
            await RunSearchAsync(site, async () =>
            {
                // Torrentio blocca (403) le richieste che arrivano tutte insieme come raffica:
                // al massimo 3 episodi alla volta invece di spararli tutti in parallelo.
                using var throttle = new SemaphoreSlim(3);
                var perEpisode = await Task.WhenAll(Enumerable.Range(1, episodeCount).Select(async ep =>
                {
                    await throttle.WaitAsync();
                    try
                    {
                        return await TorrentSearch.SearchTorrentioApiAsync(site, match.ImdbId, match.MediaType, season, ep, SearchCfg.MaxResultsPerSite, CancellationToken.None);
                    }
                    finally
                    {
                        throttle.Release();
                    }
                }));
                return perEpisode.SelectMany(r => r).ToList();
            });
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RunSearchAsync(TorrentSiteConfig site, Func<Task<List<TorrentSearchResult>>> search)
    {
        try
        {
            var found = await search();
            results = found;
            selectedSite = site;
            filterSeason = filterResolution = filterEpisode = "";
            // ITA selezionata di default quando disponibile: la maggior parte delle volte è la lingua cercata.
            filterLanguage = found.Any(r => ParseLanguage(r.Title) == "ITA") ? "ITA" : "";
            statusMessage = found.Count == 0 ? $"❌ Nessun risultato trovato su {site.Name}." : null;
        }
        catch (Exception ex)
        {
            statusMessage = $"❌ Errore durante la ricerca: {ex.Message}";
        }
    }

    // Controlla se il titolo cercato (film) o la serie sono già presenti su Plex, per avvisare
    // l'utente prima che scarichi doppioni. Confronto per titolo normalizzato (niente TMDB id
    // salvato lato Plex): tollera piccole differenze di punteggiatura/maiuscole.
    private async Task CheckOwnershipAsync()
    {
        if (poster is null) return;

        if (poster.MediaType == "movie")
        {
            var libMovies = await Plex.GetAllAsync(toTv: false, CancellationToken.None);
            ownedMovie = libMovies.Any(m => TitlesMatch(m.Title, poster.Title));
        }
        else if (poster.MediaType == "tv")
        {
            var libShows = await Plex.GetAllAsync(toTv: true, CancellationToken.None);
            var show = libShows.FirstOrDefault(s => TitlesMatch(s.Title, poster.Title));
            ownedEpisodesForShow = !string.IsNullOrWhiteSpace(show?.RatingKey)
                ? (await Plex.GetOwnedEpisodesAsync(show!.RatingKey!, CancellationToken.None)).Select(o => (o.Season, o.Episode)).ToHashSet()
                : new HashSet<(int, int)>();
        }
    }

    private static bool TitlesMatch(string a, string b)
    {
        static string Norm(string s) => new string(s.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
        var na = Norm(a);
        var nb = Norm(b);
        if (na.Length == 0 || nb.Length == 0) return false;
        return na == nb || na.Contains(nb) || nb.Contains(na);
    }

    private bool IsEpisodeOwned(int episode) =>
        currentSeasonNumber is { } s && ownedEpisodesForShow is not null && ownedEpisodesForShow.Contains((s, episode));

    private string DownloadLabel() =>
        activeDownloadPercent > 0
            ? $"{activeDownloadPercent:F0}% · {activeDownloadSpeed}"
            : "…";

    // --- Parsing (duplicato volutamente da TelegramWorker.cs: progetto separato, stesse regex) ---

    private static (int? Season, string Resolution) ParseSeasonAndResolution(string title)
    {
        int? season = null;
        var seasonMatch = System.Text.RegularExpressions.Regex.Match(title, @"\bS(?:tagione)?\.?\s*(\d{1,2})(?:E\d{1,3})?\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (seasonMatch.Success && int.TryParse(seasonMatch.Groups[1].Value, out var s))
            season = s;

        string resolution =
            System.Text.RegularExpressions.Regex.IsMatch(title, @"\b(2160p|4K|UHD)\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase) ? "4K" :
            System.Text.RegularExpressions.Regex.IsMatch(title, @"\b1080p\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase) ? "1080p" :
            System.Text.RegularExpressions.Regex.IsMatch(title, @"\b720p\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase) ? "720p" :
            System.Text.RegularExpressions.Regex.IsMatch(title, @"\b(480p|SD)\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase) ? "SD" :
            "Altro";

        return (season, resolution);
    }

    private static string ParseLanguage(string title)
    {
        if (System.Text.RegularExpressions.Regex.IsMatch(title, @"\bMULTI\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            return "MULTI";
        if (System.Text.RegularExpressions.Regex.IsMatch(title, @"\b(SUB\.?\s*ITA|ITA\.?\s*SUB)S?\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            return "SUB ITA";
        if (System.Text.RegularExpressions.Regex.IsMatch(title, @"\bITA(?:LIAN)?\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            return "ITA";
        return "ENG";
    }

    private static int? ParseEpisode(string title)
    {
        var m = System.Text.RegularExpressions.Regex.Match(title, @"\bS\d{1,2}E(\d{1,3})\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return m.Success && int.TryParse(m.Groups[1].Value, out var e) ? e : null;
    }

    private List<int> availableSeasons => results?
        .Select(r => ParseSeasonAndResolution(r.Title).Season)
        .Where(s => s.HasValue).Select(s => s!.Value)
        .Distinct().OrderBy(s => s).ToList() ?? new();

    private List<string> availableResolutions => results?
        .Select(r => ParseSeasonAndResolution(r.Title).Resolution)
        .Distinct().ToList() ?? new();

    private List<string> availableLanguages => results?
        .Select(r => ParseLanguage(r.Title))
        .Distinct().ToList() ?? new();

    private List<int> availableEpisodes => results?
        .Select(r => ParseEpisode(r.Title))
        .Where(e => e.HasValue).Select(e => e!.Value)
        .Distinct().OrderBy(e => e).ToList() ?? new();

    private List<TorrentSearchResult> filteredResults
    {
        get
        {
            if (results is null) return new();
            var q = results.AsEnumerable();
            if (!string.IsNullOrEmpty(filterSeason) && int.TryParse(filterSeason, out var s))
                q = q.Where(r => ParseSeasonAndResolution(r.Title).Season == s);
            if (!string.IsNullOrEmpty(filterResolution))
                q = q.Where(r => ParseSeasonAndResolution(r.Title).Resolution == filterResolution);
            if (!string.IsNullOrEmpty(filterLanguage))
                q = q.Where(r => ParseLanguage(r.Title) == filterLanguage);
            if (!string.IsNullOrEmpty(filterEpisode) && int.TryParse(filterEpisode, out var ep))
                q = q.Where(r => ParseEpisode(r.Title) == ep);
            return q.OrderBy(r => ParseEpisode(r.Title) ?? int.MaxValue).ToList();
        }
    }

    private TorrentSearchResult? enqueuedResult;

    // Stato della selezione file per riga di risultato (Punto: selezione file anche da Cerca, non
    // solo da AllDebrid). A differenza di un magnet AllDebrid già pronto, qui il magnet va prima
    // risolto/caricato/atteso: "Preparing" copre quella fase, poi Files viene popolato e l'utente
    // può scegliere cosa scaricare, esattamente come nella tab AllDebrid.
    private class FileSelectState
    {
        public bool ShowPanel { get; set; }
        public bool Preparing { get; set; }
        public bool Busy { get; set; }
        public string? Message { get; set; }
        public string? MagnetId { get; set; }
        public List<MagnetFile>? Files { get; set; }
        public HashSet<string> SelectedLinks { get; set; } = new();

        // Inizializzato dal toggle di pagina alla prima apertura della riga, sovrascrivibile per
        // quel solo file dall'icona per-risultato (vedi ToggleRowProvider).
        public string Provider { get; set; } = "allDebrid";
    }

    private readonly Dictionary<TorrentSearchResult, FileSelectState> fileStates = new();

    private FileSelectState GetFileState(TorrentSearchResult r)
    {
        if (!fileStates.TryGetValue(r, out var state))
        {
            state = new FileSelectState { Provider = pageProvider };
            fileStates[r] = state;
        }
        return state;
    }

    private static string Truncate(string s, int max) => s.Length <= max ? s : s[..max] + "…";

    private static string FormatSize(long bytes)
    {
        double size = bytes;
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        int unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:0.##} {units[unit]}";
    }

    private async Task ToggleFilesAsync(TorrentSearchResult r, FileSelectState state)
    {
        if (state.ShowPanel)
        {
            state.ShowPanel = false;
            return;
        }

        state.ShowPanel = true;
        if (state.MagnetId is not null || state.Files is not null)
            return; // già preparato in precedenza, mostra solo il pannello

        state.Preparing = true;
        state.Message = null;
        try
        {
            var toTv = destinationIsTv == "true";
            var provider = ParseProvider(state.Provider);
            var prep = await Orchestrator.PrepareSearchResultAsync(
                r, selectedSite?.RequiresVpn == true, toTv, SearchCfg.TimeoutSeconds, CancellationToken.None,
                onStatus: msg => { state.Message = msg; InvokeAsync(StateHasChanged); },
                provider: provider);

            if (!prep.Success)
            {
                state.Message = prep.Message;
                state.ShowPanel = false;
                return;
            }

            state.MagnetId = prep.MagnetId;
            state.Message = null;
            state.Files = await DebridFactory.Get(provider).GetMagnetFilesDetailedAsync(prep.MagnetId!, CancellationToken.None);
            state.SelectedLinks = state.Files.Select(f => f.Link).ToHashSet();
        }
        catch (Exception ex)
        {
            state.Message = $"❌ Errore preparando il magnet: {ex.Message}";
            state.ShowPanel = false;
        }
        finally
        {
            state.Preparing = false;
        }
    }

    private void ToggleFileSelection(FileSelectState state, string link, bool isChecked)
    {
        if (isChecked) state.SelectedLinks.Add(link);
        else state.SelectedLinks.Remove(link);
    }

    // "Guarda in streaming": prepara il magnet (se non già fatto, stesso passo di "Scegli file")
    // e va dritto al player se c'è un solo file, altrimenti lascia aperto il pannello per scegliere
    // quale guardare tramite il pulsante ▶️ per riga.
    private async Task WatchResultAsync(TorrentSearchResult r, FileSelectState state)
    {
        if (state.Files is null)
        {
            await ToggleFilesAsync(r, state);
            if (state.Files is null || state.Files.Count == 0) return;
        }

        if (state.Files.Count == 1)
        {
            NavigateToWatch(state.Files[0], r.Title, state.Provider);
            return;
        }

        state.ShowPanel = true;
    }

    private void NavigateToWatch(MagnetFile f, string title, string provider) =>
        Nav.NavigateTo($"/guarda?link={Uri.EscapeDataString(f.Link)}&title={Uri.EscapeDataString(title)}&provider={provider}");

    // "Acquisisci in libreria" (docs/piano-premiumize-libreria.md, solo Premiumize): a differenza
    // di DownloadSelectedAsync non scarica nulla su disco, registra solo il tracking e chiede il
    // refresh Plex — il file resta nel cloud Premiumize, già visibile a Plex tramite il mount
    // WebDAV configurato come cartella della sezione scelta.
    private async Task AcquireToLibraryAsync(TorrentSearchResult r, FileSelectState state)
    {
        if (selectedCandidate is null || selectedSectionId is null) return;

        if (state.MagnetId is null)
        {
            await ToggleFilesAsync(r, state);
            if (state.MagnetId is null) return; // preparazione fallita, messaggio già impostato
        }

        state.Busy = true;
        state.Message = null;
        try
        {
            var toTv = destinationIsTv == "true";
            var result = await Orchestrator.AcquireReadyMagnetToLibraryAsync(
                state.MagnetId, r.Title, toTv, selectedCandidate.TmdbId, selectedSectionId.Value, CancellationToken.None,
                onStatus: msg => { state.Message = msg; InvokeAsync(StateHasChanged); });

            state.Message = result.Message;
        }
        catch (Exception ex)
        {
            state.Message = $"❌ Errore durante l'acquisizione: {ex.Message}";
        }
        finally
        {
            state.Busy = false;
        }
    }

    private async Task DownloadSelectedAsync(TorrentSearchResult r, FileSelectState state)
    {
        if (state.MagnetId is null) return;

        state.Busy = true;
        state.Message = null;
        try
        {
            var toTv = destinationIsTv == "true";
            var result = await Orchestrator.DownloadReadyMagnetAsync(
                state.MagnetId, r.Title, toTv, r.SourceListName ?? r.SiteName, CancellationToken.None,
                onStatus: msg => { state.Message = msg; InvokeAsync(StateHasChanged); },
                sectionId: selectedSectionId,
                selectedFileLinks: state.SelectedLinks,
                provider: ParseProvider(state.Provider));

            state.Message = result.Message;
        }
        catch (Exception ex)
        {
            state.Message = $"❌ Errore durante il download: {ex.Message}";
        }
        finally
        {
            state.Busy = false;
        }
    }

    private void EnqueueSelected(TorrentSearchResult r, FileSelectState state)
    {
        if (state.MagnetId is null) return;

        Queue.Enqueue(new QueuedDownloadItem
        {
            Title = r.Title,
            SizeText = r.SizeText,
            SourceName = r.SourceListName ?? r.SiteName,
            ToTv = destinationIsTv == "true",
            SectionId = selectedSectionId,
            DestinationLabel = CurrentSectionOptions.FirstOrDefault(s => s.Id == selectedSectionId)?.Title,
            MagnetId = state.MagnetId,
            SelectedFileLinks = new HashSet<string>(state.SelectedLinks),
            Provider = ParseProvider(state.Provider)
        });
        state.Message = "Aggiunto alla coda";
    }

    private void EnqueueResult(TorrentSearchResult result)
    {
        var provider = GetFileState(result).Provider;
        Queue.Enqueue(new QueuedDownloadItem
        {
            Title = result.Title,
            SizeText = result.SizeText,
            SourceName = result.SourceListName ?? result.SiteName,
            ToTv = destinationIsTv == "true",
            SectionId = selectedSectionId,
            DestinationLabel = CurrentSectionOptions.FirstOrDefault(s => s.Id == selectedSectionId)?.Title,
            RequiresVpn = selectedSite?.RequiresVpn == true,
            TimeoutSeconds = SearchCfg.TimeoutSeconds,
            SearchResult = result,
            Provider = ParseProvider(provider)
        });
        enqueuedResult = result;
    }

    private async Task DownloadAsync(TorrentSearchResult result)
    {
        busy = true;
        downloadingResult = result;
        activeDownloadPercent = 0;
        downloadResultMessage = null;
        statusMessage = null;
        try
        {
            var toTv = destinationIsTv == "true";
            var provider = GetFileState(result).Provider;

            var pipelineResult = await Orchestrator.DownloadFromSearchResultAsync(
                result, selectedSite?.RequiresVpn == true, toTv, SearchCfg.TimeoutSeconds, CancellationToken.None,
                onStatus: msg => { statusMessage = msg; InvokeAsync(StateHasChanged); },
                sectionId: selectedSectionId,
                provider: ParseProvider(provider));

            downloadResultMessage = pipelineResult.Message;
        }
        catch (Exception ex)
        {
            statusMessage = $"❌ Errore durante il download: {ex.Message}";
        }
        finally
        {
            busy = false;
            downloadingResult = null;
        }
    }
}
